ENV=dev
DATABASE_URL=postgresql+asyncpg://analyst:analyst@postgres:5432/analyst
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_BUCKET=analyst
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
JWT_SECRET=change-me-32-bytes-minimum
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_TOKEN_BUDGET_PER_DATASET=200000
MAX_UPLOAD_MB=200
MAX_ROWS=2000000
MAX_COLS=500
RETENTION_DAYS=30
